# Letter Registry System — environment template
# Copy to `.env` and fill in per-environment values. NEVER commit `.env`.
# Every value below is a placeholder, not a real credential.

# --- Application -----------------------------------------------------
APP_NAME=Letter Registry System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security / JWT authentication ------------------------------------
# Signs and verifies every access token issued by POST /api/v1/auth/login.
# Generate a real one per environment — never reuse this placeholder, and
# never commit the real value: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this value invalidates every previously issued token.
SECRET_KEY=replace-with-a-generated-secret
# HMAC algorithm for JWT signing. HS256 is symmetric (same SECRET_KEY signs
# and verifies) and is the only algorithm this codebase has been reviewed
# against — see docs/architecture/authentication.md, "JWT design" before
# changing it.
ALGORITHM=HS256
# How long an access token remains valid after login. There is currently no
# refresh-token mechanism (deferred — see docs/architecture/authentication.md,
# "Deferred to Phase 3B"), so a user must log in again after this expires.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database --------------------------------------------------------
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/lrs

# --- CORS ------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Document storage ------------------------------------------------
# Filesystem root for scanned letters. Absolute path in production.
STORAGE_PATH=../storage/letters
# Maximum accepted size, in bytes, for one uploaded document. 10 MB
# (the code default) is an architectural recommendation, not a confirmed
# organizational limit — see docs/architecture/document-management.md §9.
MAX_DOCUMENT_SIZE_BYTES=10485760
