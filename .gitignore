# ------------------------------------------------------------------
# Letter Registry System — Git ignore rules
# ------------------------------------------------------------------

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Node / frontend
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Uploaded documents — never commit letter files
storage/letters/*
!storage/letters/.gitkeep

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
